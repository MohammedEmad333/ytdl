<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        The queue survives leaving the app, which means a foreground service, which means
        a notification. From Android 14 the type has to be declared here AND passed to
        startForeground(), and they have to agree or the system refuses to start it.
        dataSync is the right type for downloads.
        POST_NOTIFICATIONS is runtime-requested from Android 13 up — without it the service
        still works but its progress notification is silently invisible.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Framework resources only — no strings.xml, no launcher icon PNGs, no styles.xml.
        Icons are binary, and this repo deliberately has no binary files in it.
        No storage permission: minSdk is 29, and MediaStore writes to the public Downloads
        collection have been permission-free since Android 10.
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Media Downloader"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            All shared text goes through the router. YouTube is forwarded unchanged; Spotify
            tracks are matched to a YouTube source first and then use the existing downloader.
        -->
        <activity
            android:name=".LinkRouterActivity"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Allow opening a Spotify track URL directly with the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="open.spotify.com"
                    android:pathPrefix="/track/" />
            </intent-filter>

            <!-- Spotify's shortened share links redirect to open.spotify.com/track/... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="spotify.link" />
            </intent-filter>
        </activity>

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
