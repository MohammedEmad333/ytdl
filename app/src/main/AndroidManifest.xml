<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        The queue survives leaving the app, which means a foreground service, which means
        a notification. From Android 14 the type has to be declared here AND passed to
        startForeground(), and they have to agree or the system refuses to start it.
        dataSync is the right type for downloads.
        POST_NOTIFICATIONS is runtime-requested from Android 13 up — without it the service
        still works but its progress notification is silently invisible.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Framework resources only — no strings.xml, no launcher icon PNGs, no styles.xml.
        Icons are binary, and this repo deliberately has no binary files in it.
        No storage permission: minSdk is 29, and MediaStore writes to the public Downloads
        collection have been permission-free since Android 10.
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="YT Downloader"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!--
            singleTop matters for the share filter: without it, every share stacks another
            copy of the activity instead of arriving at onNewIntent.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share from YouTube straight into here, rather than copy/switch/paste. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
